XAI_API_KEY=your_xai_api_key_here
PORT=8787

# Spotify Web Playback (Premium). Create an app at https://developer.spotify.com/dashboard
# Redirect URI must match exactly:
#   http://127.0.0.1:5173/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/spotify/callback

# X / Twitter API — https://developer.x.com/
# Prefer App-only Bearer for read endpoints.
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# YouTube Data API v3 (optional but better Starship webcast search)
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
